# Normalize all text files to LF in the repo and working tree (cloud dev runs on Linux)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf

# Binary files: never touch line endings or diff them
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.xlsx binary
*.xls  binary
*.docx binary
*.zip  binary
*.exe  binary
*.dll  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
