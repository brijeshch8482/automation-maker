# FastAPI settings (api/src/api/config.py). Copy to .env for local dev; never commit .env.

# Local dev defaults: SQLite, fake generation provider, dev login ("Authorization: Bearer dev:<user>").
DATABASE_URL=sqlite+aiosqlite:///./makemyexe-dev.db
PUBLIC_BASE_URL=http://localhost:8000
PROVIDER=fake
DEV_AUTH=true

# Internal phase with real routines (docs/ROUTINES.md §1). The app refuses to start with
# PROVIDER=routine while the secrets below are defaults or DEV_AUTH=true.
# PROVIDER=routine
# PUBLIC_BASE_URL=https://dev-api.<your-domain>
# ROUTINE_SPEC_URL=https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
# ROUTINE_SPEC_TOKEN=sk-ant-oat01-...
# ROUTINE_BUILD_URL=https://api.anthropic.com/v1/claude_code/routines/trig_.../fire
# ROUTINE_BUILD_TOKEN=sk-ant-oat01-...
# CALLBACK_TOKEN_SECRET=<random 32+ bytes>
# BUILD_CALLBACK_SECRET=<random 32+ bytes, same as automation-builds Job 2>
# BUILDS_GITHUB_TOKEN=<fine-grained token: actions:write on automation-builds only>
# BUILDS_REPO=brijeshch8482/automation-builds
# SUPABASE_JWT_SECRET=<Supabase project JWT secret>
# CORS_ORIGINS=["http://localhost:5173"]
