{
  "calc.line_totals": {
    "description": "Per-row amount = qty x rate for a table input, plus subtotal, tax (percent) and grand total.",
    "produces": "object with rows, subtotal, tax, total",
    "args": {
      "additionalProperties": false,
      "properties": {
        "table": {
          "title": "Table",
          "type": "string",
          "x-field-types": [
            "table"
          ],
          "x-ref": "input"
        },
        "qty": {
          "title": "Qty",
          "type": "string",
          "x-ref": "column",
          "x-table-arg": "table"
        },
        "rate": {
          "title": "Rate",
          "type": "string",
          "x-ref": "column",
          "x-table-arg": "table"
        },
        "tax": {
          "anyOf": [
            {
              "type": "string",
              "x-ref": "value"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tax"
        }
      },
      "required": [
        "table",
        "qty",
        "rate"
      ],
      "title": "LineTotalsArgs",
      "type": "object"
    }
  },
  "counter.next": {
    "description": "Next value of a local counter that persists between runs, as prefix + zero-padded number (e.g. INV-0007).",
    "produces": "text",
    "args": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "prefix": {
          "default": "",
          "maxLength": 20,
          "title": "Prefix",
          "type": "string"
        },
        "start": {
          "default": 1,
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "pad": {
          "default": 0,
          "maximum": 12,
          "minimum": 0,
          "title": "Pad",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "CounterNextArgs",
      "type": "object"
    }
  },
  "custom.step": {
    "description": "Run a generated custom function (custom_step.py) through the context API. Use only when no combination of blocks can do the job.",
    "produces": "value returned by the function",
    "args": {
      "additionalProperties": false,
      "properties": {
        "function": {
          "default": "run",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "title": "Function",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "CustomStepArgs",
      "type": "object"
    }
  },
  "file.save": {
    "description": "Save a document produced by an earlier step to a folder under a new name. Never overwrites: adds a suffix if the name exists.",
    "produces": "path of the saved file",
    "args": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string",
          "x-ref": "value"
        },
        "folder": {
          "title": "Folder",
          "type": "string",
          "x-ref": "value"
        },
        "name": {
          "title": "Name",
          "type": "string",
          "x-template": true
        }
      },
      "required": [
        "source",
        "folder",
        "name"
      ],
      "title": "FileSaveArgs",
      "type": "object"
    }
  },
  "files.rename": {
    "description": "Plan new names for a list of files from a pattern. Nothing changes until the user confirms the preview; every rename goes to the undo log and clashes get ' (2)'.",
    "produces": "rename plan (applied after the preview)",
    "args": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "title": "Files",
          "type": "string",
          "x-ref": "value"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string",
          "x-per-item": [
            "n",
            "name",
            "date"
          ],
          "x-template": true
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "x-ref": "value"
            },
            {
              "type": "integer"
            }
          ],
          "default": 1,
          "title": "Start"
        },
        "pad": {
          "default": 0,
          "maximum": 6,
          "minimum": 0,
          "title": "Pad",
          "type": "integer"
        }
      },
      "required": [
        "files",
        "name"
      ],
      "title": "FilesRenameArgs",
      "type": "object"
    }
  },
  "files.scan": {
    "description": "List the files directly inside a folder (no subfolders, hidden files skipped), optionally only some extensions, sorted naturally by name or by date modified.",
    "produces": "list of files",
    "args": {
      "additionalProperties": false,
      "properties": {
        "folder": {
          "title": "Folder",
          "type": "string",
          "x-ref": "value"
        },
        "extensions": {
          "items": {
            "pattern": "^[a-z0-9]+$",
            "type": "string"
          },
          "title": "Extensions",
          "type": "array"
        },
        "sort": {
          "default": "name",
          "enum": [
            "name",
            "modified"
          ],
          "title": "Sort",
          "type": "string"
        }
      },
      "required": [
        "folder"
      ],
      "title": "FilesScanArgs",
      "type": "object"
    }
  },
  "pdf.from_files": {
    "description": "Make one PDF from photos, screenshots, scans (JPG, PNG, WebP, BMP, TIFF, GIF, HEIC) and pages of existing PDFs, in the given order. Photos are turned upright, put on A4, Letter or a page their own size, and scaled to print quality to keep the file small. Originals are only read.",
    "produces": "PDF document",
    "args": {
      "additionalProperties": false,
      "description": "Options come from inputs (usually select/checkbox fields); left out means the default.",
      "properties": {
        "files": {
          "title": "Files",
          "type": "string",
          "x-ref": "value"
        },
        "page_size": {
          "anyOf": [
            {
              "type": "string",
              "x-ref": "value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Size"
        },
        "margin": {
          "anyOf": [
            {
              "type": "string",
              "x-ref": "value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Margin"
        },
        "smaller": {
          "anyOf": [
            {
              "type": "string",
              "x-ref": "value"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Smaller"
        }
      },
      "required": [
        "files"
      ],
      "title": "PdfFromFilesArgs",
      "type": "object"
    }
  },
  "pdf.merge": {
    "description": "Merge the selected PDF files, in order, into one PDF. Originals are not changed.",
    "produces": "PDF document",
    "args": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "title": "Files",
          "type": "string",
          "x-field-types": [
            "files"
          ],
          "x-ref": "input"
        }
      },
      "required": [
        "files"
      ],
      "title": "PdfMergeArgs",
      "type": "object"
    }
  },
  "pdf.render_template": {
    "description": "Render a PDF from a bundled template using the inputs, settings and earlier step outputs.",
    "produces": "PDF document",
    "args": {
      "additionalProperties": false,
      "properties": {
        "template": {
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Template",
          "type": "string"
        }
      },
      "required": [
        "template"
      ],
      "title": "RenderTemplateArgs",
      "type": "object"
    }
  }
}
