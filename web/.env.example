# Web build settings (Vite). Copy to web/.env.local for local dev; never commit real keys.

# FastAPI base URL. Leave empty to serve the catalog from the bundled spec files only.
VITE_API_URL=http://localhost:8000

# Dev-only login by name; works only when the API also runs with DEV_AUTH=true.
VITE_DEV_AUTH=true

# Supabase login (email magic links). When set, it replaces the dev login.
# The "publishable key" (sb_publishable_...) from Supabase > Project Settings > API Keys.
# It is safe in the browser. Never put the secret key (sb_secret_...) here.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
